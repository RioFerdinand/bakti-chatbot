# Model LLM yang dipakai Ollama untuk menjawab pertanyaan
LLM_MODEL=llama3.2

# Model embedding untuk RAG
EMBEDDING_MODEL=nomic-embed-text

# Lokasi penyimpanan vector database ChromaDB
CHROMA_DIR=chroma_db

# Folder tempat dokumen sumber (pdf/word) disimpan
DATA_DIR=data

# Alamat Ollama server (default lokal)
OLLAMA_HOST=http://localhost:11434

# Alamat backend FastAPI (dipakai oleh frontend Streamlit)
BACKEND_URL=http://localhost:8000
